{
  "title": "正方体体积计算",
  "summary": "边长自乘三次得立方体体积",
  "scene_svg": "<defs>\\n  <filter id=\"shadow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\\n    <feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"3\"/>\\n    <feOffset dx=\"2\" dy=\"2\" result=\"offsetblur\"/>\\n    <feFlood flood-color=\"#000000\" flood-opacity=\"0.2\"/>\\n    <feComposite in2=\"offsetblur\" operator=\"in\"/>\\n    <feMerge>\\n      <feMergeNode/>\\n      <feMergeNode in=\"SourceGraphic\"/>\\n    </feMerge>\\n  </filter>\\n  \\n  <filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\\n    <feGaussianBlur stdDeviation=\"4\" result=\"coloredBlur\"/>\\n    <feMerge>\\n      <feMergeNode in=\"coloredBlur\"/>\\n      <feMergeNode in=\"SourceGraphic\"/>\\n    </feMerge>\\n  </filter>\\n  \\n  <linearGradient id=\"redGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\\n    <stop offset=\"0%\" stop-color=\"#C73E3A\" stop-opacity=\"0.8\"/>\\n    <stop offset=\"100%\" stop-color=\"#C73E3A\" stop-opacity=\"0.3\"/>\\n  </linearGradient>\\n  \\n  <linearGradient id=\"grayGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\\n    <stop offset=\"0%\" stop-color=\"#666666\" stop-opacity=\"0.8\"/>\\n    <stop offset=\"100%\" stop-color=\"#999999\" stop-opacity=\"0.3\"/>\\n  </linearGradient>\\n  \\n  <style>\\n    .floating {\\n      animation: float 3s ease-in-out infinite;\\n    }\\n    \\n    .heartbeat {\\n      animation: heartbeat 2s ease-in-out infinite;\\n    }\\n    \\n    .glowing {\\n      animation: glow 2s ease-in-out infinite;\\n    }\\n    \\n    @keyframes float {\\n      0%, 100% { transform: translateY(0); }\\n      50% { transform: translateY(-10px); }\\n    }\\n    \\n    @keyframes heartbeat {\\n      0%, 100% { transform: scale(1); }\\n      50% { transform: scale(1.1); }\\n    }\\n    \\n    @keyframes glow {\\n      0%, 100% { filter: drop-shadow(0 0 3px rgba(199, 62, 58, 0.5)); }\\n      50% { filter: drop-shadow(0 0 8px rgba(199, 62, 58, 0.8)); }\\n    }\\n    \\n    .dashed-line {\\n      stroke-dasharray: 5, 5;\\n      stroke-dashoffset: 0;\\n      animation: dash 20s linear infinite;\\n    }\\n    \\n    @keyframes dash {\\n      to { stroke-dashoffset: -100; }\\n    }\\n    \\n    .svg-elem {\\n      transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);\\n    }\\n    \\n    .fade-in {\\n      opacity: 0;\\n      transition: opacity 1s ease-in-out;\\n    }\\n    \\n    .fade-in.active {\\n      opacity: 1;\\n    }\\n  </style>\\n</defs>\\n\\n<g id=\"cube-container\">\\n  <!-- 正方体底面 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 0\" x-transition:enter=\"transition-all duration-700 ease-out\" x-transition:leave=\"transition-all duration-500 ease-in\">\\n    <polygon points=\"200,350 350,350 400,300 250,300\" fill=\"#F5F2ED\" stroke=\"#333333\" stroke-width=\"2\" filter=\"url(#shadow)\"/>\\n  </g>\\n  \\n  <!-- 正方体左侧面 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 0\" x-transition:enter=\"transition-all duration-700 ease-out\" x-transition:leave=\"transition-all duration-500 ease-in\">\\n    <polygon points=\"200,350 200,200 250,150 250,300\" fill=\"#E8E5E0\" stroke=\"#333333\" stroke-width=\"2\" filter=\"url(#shadow)\"/>\\n  </g>\\n  \\n  <!-- 正方体右侧面 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 0\" x-transition:enter=\"transition-all duration-700 ease-out\" x-transition:leave=\"transition-all duration-500 ease-in\">\\n    <polygon points=\"350,350 350,200 400,150 400,300\" fill=\"#D5D0C8\" stroke=\"#333333\" stroke-width=\"2\" filter=\"url(#shadow)\"/>\\n  </g>\\n  \\n  <!-- 正方体顶面 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 0\" x-transition:enter=\"transition-all duration-700 ease-out\" x-transition:leave=\"transition-all duration-500 ease-in\">\\n    <polygon points=\"200,200 350,200 400,150 250,150\" fill=\"#FFFFFF\" stroke=\"#333333\" stroke-width=\"2\" filter=\"url(#shadow)\"/>\\n  </g>\\n  \\n  <!-- 边长标记 - 底面 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 1\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <line x1=\"200\" y1=\"380\" x2=\"350\" y2=\"380\" stroke=\"#C73E3A\" stroke-width=\"2\" class=\"dashed-line\"/>\\n    <text x=\"275\" y=\"400\" text-anchor=\"middle\" fill=\"#C73E3A\" font-size=\"16\" font-weight=\"bold\">a</text>\\n  </g>\\n  \\n  <!-- 边长标记 - 垂直边 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 1\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <line x1=\"180\" y1=\"350\" x2=\"180\" y2=\"200\" stroke=\"#C73E3A\" stroke-width=\"2\" class=\"dashed-line\"/>\\n    <text x=\"165\" y=\"275\" text-anchor=\"middle\" fill=\"#C73E3A\" font-size=\"16\" font-weight=\"bold\" transform=\"rotate(-90, 165, 275)\">a</text>\\n  </g>\\n  \\n  <!-- 体积公式展示 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 2\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <foreignObject x=\"100\" y=\"50\" width=\"200\" height=\"60\">\\n      <div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; justify-content: center; align-items: center; padding: 10px; background-color: #F5F2ED; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\\n        <span style=\"font-size: 24px; font-weight: bold; color: #333333;\">V = a³</span>\\n      </div>\\n    </foreignObject>\\n  </g>\\n  \\n  <!-- 体积计算动画 - 小立方体填充 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 3\" x-transition:enter=\"transition-all duration-1200 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <!-- 第一层小立方体 -->\\n    <g>\\n      <rect x=\"210\" y=\"340\" width=\"15\" height=\"15\" fill=\"url(#redGradient)\" class=\"heartbeat\"/>\\n      <rect x=\"230\" y=\"340\" width=\"15\" height=\"15\" fill=\"url(#redGradient)\" class=\"heartbeat\" style=\"animation-delay: 0.2s;\"/>\\n      <rect x=\"250\" y=\"340\" width=\"15\" height=\"15\" fill=\"url(#redGradient)\" class=\"heartbeat\" style=\"animation-delay: 0.4s;\"/>\\n      <rect x=\"270\" y=\"340\" width=\"15\" height=\"15\" fill=\"url(#redGradient)\" class=\"heartbeat\" style=\"animation-delay: 0.6s;\"/>\\n      <rect x=\"290\" y=\"340\" width=\"15\" height=\"15\" fill=\"url(#redGradient)\" class=\"heartbeat\" style=\"animation-delay: 0.8s;\"/>\\n      <rect x=\"310\" y=\"340\" width=\"15\" height=\"15\" fill=\"url(#redGradient)\" class=\"heartbeat\" style=\"animation-delay: 1s;\"/>\\n      <rect x=\"330\" y=\"340\" width=\"15\" height=\"15\" fill=\"url(#redGradient)\" class=\"heartbeat\" style=\"animation-delay: 1.2s;\"/>\\n    </g>\\n  </g>\\n  \\n  <!-- 示例1计算 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 4\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <foreignObject x=\"450\" y=\"200\" width=\"200\" height=\"80\">\\n      <div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 15px; background-color: #F5F2ED; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\\n        <span style=\"font-size: 18px; color: #333333; margin-bottom: 10px;\">当 a = 3 时</span>\\n        <span style=\"font-size: 20px; font-weight: bold; color: #C73E3A;\">V = 3³ = 27</span>\\n      </div>\\n    </foreignObject>\\n  </g>\\n  \\n  <!-- 示例2计算 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 5\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <foreignObject x=\"450\" y=\"300\" width=\"200\" height=\"80\">\\n      <div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 15px; background-color: #F5F2ED; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\\n        <span style=\"font-size: 18px; color: #333333; margin-bottom: 10px;\">当 a = 5 时</span>\\n        <span style=\"font-size: 20px; font-weight: bold; color: #C73E3A;\">V = 5³ = 125</span>\\n      </div>\\n    </foreignObject>\\n  </g>\\n  \\n  <!-- 体积单位展示 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 6\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <foreignObject x=\"450\" y=\"400\" width=\"200\" height=\"60\">\\n      <div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 15px; background-color: #F5F2ED; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\\n        <span style=\"font-size: 18px; color: #333333;\">体积单位：立方单位 (unit³)</span>\\n      </div>\\n    </foreignObject>\\n  </g>\\n  \\n  <!-- 比较不同边长 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 7\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <foreignObject x=\"100\" y=\"450\" width=\"300\" height=\"80\">\\n      <div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 15px; background-color: #F5F2ED; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\\n        <span style=\"font-size: 18px; color: #333333;\">边长增加，体积呈立方增长</span>\\n        <span style=\"font-size: 16px; color: #666666;\">3 → 5 (边长增加 66.7%)，体积从 27 → 125 (体积增加 363%)</span>\\n      </div>\\n    </foreignObject>\\n  </g>\\n  \\n  <!-- 实际应用 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 8\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <foreignObject x=\"100\" y=\"100\" width=\"300\" height=\"80\">\\n      <div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 15px; background-color: #F5F2ED; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\\n        <span style=\"font-size: 18px; color: #333333;\">实际应用：包装盒体积计算</span>\\n        <span style=\"font-size: 16px; color: #666666;\">边长 10cm 的立方体包装盒，体积 = 10³ = 1000 cm³</span>\\n      </div>\\n    </foreignObject>\\n  </g>\\n  \\n  <!-- 验证结果 -->\\n  <g class=\"svg-elem\" x-show=\"sceneStep >= 9\" x-transition:enter=\"transition-all duration-1000 ease-out\" x-transition:leave=\"transition-all duration-300 ease-in\">\\n    <foreignObject x=\"450\" y=\"450\" width=\"200\" height=\"60\">\\n      <div xmlns=\"http://www.w3.org/1999/xhtml\" style=\"display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 15px; background-color: #F5F2ED; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\\n        <span style=\"font-size: 18px; color: #333333; margin-bottom: 10px;\">验证计算结果</span>\\n        <span style=\"font-size: 20px; font-weight: bold; color: #4CAF50;\">✓ 计算正确</span>\\n      </div>\\n    </foreignObject>\\n  </g>\\n  \\n  <!-- 思维流动线1 -->\\n  <path d=\"M 275,400 Q 400,350 450,240\" stroke=\"#C73E3A\" stroke-width=\"2\" fill=\"none\" class=\"dashed-line\" x-show=\"sceneStep >= 3\"/>\\n  \\n  <!-- 思维流动线2 -->\\n  <path d=\"M 450,240 Q 350,300 275,275\" stroke=\"#666666\" stroke-width=\"2\" fill=\"none\" class=\"dashed-line\" x-show=\"sceneStep >= 4\"/>\\n  \\n  <!-- 装饰元素 - 问号 -->\\n  <text x=\"150\" y=\"250\" font-size=\"40\" fill=\"#C73E3A\" class=\"floating\" x-show=\"sceneStep == 0\">?</text>\\n  \\n  <!-- 装饰元素 - 等号 -->\\n  <text x=\"380\" y=\"225\" font-size=\"40\" fill=\"#C73E3A\" class=\"floating\" x-show=\"sceneStep >= 2\">=</text>\\n  \\n  <!-- 装饰元素 - 指数符号 -->\\n  <text x=\"420\" y=\"200\" font-size=\"30\" fill=\"#C73E3A\" class=\"floating\" x-show=\"sceneStep >= 2\">³</text>\\n  \\n  <!-- 辅助线 - 连接边长和体积公式 -->\\n  <line x1=\"275\" y1=\"380\" x2=\"200\" y2=\"80\" stroke=\"#999999\" stroke-width=\"1\" stroke-dasharray=\"5,5\" x-show=\"sceneStep >= 2\"/>\\n</g>",
  "steps_json": "[\n    {\n        \"title\": \"正方体介绍\",\n        \"description\": \"认识正方体的基本属性\",\n        \"bubbleText\": \"大家好！今天我们要学习正方体的体积计算。首先，让我们认识一下正方体。\",\n        \"bubblePos\": {\n            \"x\": 100,\n            \"y\": 100\n        }\n    },\n    {\n        \"title\": \"边长概念\",\n        \"description\": \"了解正方体的边长\",\n        \"bubbleText\": \"正方体有12条相等的边，每条边的长度都相同，我们称之为边长a。\",\n        \"bubblePos\": {\n            \"x\": 150,\n            \"y\": 150\n        }\n    },\n    {\n        \"title\": \"体积公式\",\n        \"description\": \"引入正方体体积计算公式\",\n        \"bubbleText\": \"正方体的体积等于边长的立方，公式为 V = a³。这意味着体积是边长乘以边长再乘以边长。\",\n        \"bubblePos\": {\n            \"x\": 200,\n            \"y\": 100\n        }\n    },\n    {\n        \"title\": \"体积概念\",\n        \"description\": \"展示体积与边长的关系\",\n        \"bubbleText\": \"体积是指物体所占空间的大小。对于正方体，它的体积等于边长的立方。\",\n        \"bubblePos\": {\n            \"x\": 250,\n            \"y\": 150\n        }\n    },\n    {\n        \"title\": \"计算示例1\",\n        \"description\": \"边长为3的正方体体积计算\",\n        \"bubbleText\": \"如果正方体的边长a=3，那么体积V=3³=27。我们可以看到，边长为3的正方体可以容纳27个单位立方体。\",\n        \"bubblePos\": {\n            \"x\": 500,\n            \"y\": 200\n        }\n    },\n    {\n        \"title\": \"计算示例2\",\n        \"description\": \"边长为5的正方体体积计算\",\n        \"bubbleText\": \"如果正方体的边长a=5，那么体积V=5³=125。边长为5的正方体可以容纳125个单位立方体。\",\n        \"bubblePos\": {\n            \"x\": 500,\n            \"y\": 300\n        }\n    },\n    {\n        \"title\": \"体积单位\",\n        \"description\": \"理解体积单位的含义\",\n        \"bubbleText\": \"体积的单位是立方单位，如立方厘米(cm³)、立方米(m³)等。这表示边长单位的三次方。\",\n        \"bubblePos\": {\n            \"x\": 500,\n            \"y\": 400\n        }\n    },\n    {\n        \"title\": \"体积增长规律\",\n        \"description\": \"比较不同边长正方体的体积\",\n        \"bubbleText\": \"当边长增加时，体积呈立方增长。边长增加一点，体积会大幅增加。例如，边长从3增加到5(增加66.7%)，体积从27增加到125(增加363%)。\",\n        \"bubblePos\": {\n            \"x\": 200,\n            \"y\": 450\n        }\n    },\n    {\n        \"title\": \"实际应用\",\n        \"description\": \"正方体体积计算的实际应用\",\n        \"bubbleText\": \"在实际生活中，我们经常需要计算正方体物体的体积，如包装盒、储物箱等。计算体积可以帮助我们了解空间占用情况。\",\n        \"bubblePos\": {\n            \"x\": 150,\n            \"y\": 100\n        }\n    },\n    {\n        \"title\": \"验证结果\",\n        \"description\": \"验证计算结果的正确性\",\n        \"bubbleText\": \"通过以上步骤，我们已经掌握了正方体体积的计算方法。记住公式V=a³，并正确应用到实际问题中。\",\n        \"bubblePos\": {\n            \"x\": 500,\n            \"y\": 450\n        }\n    }\n]"
