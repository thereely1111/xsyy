# API 密钥配置
# 复制此文件为 .env 并填入你的实际密钥

# ══════════════════════════════════════════════════════════════════════════
#  数据库统一入口 —— 切环境（本地/测试 ↔ 生产）**只改本段**，下面两条 URL 自动跟随
#  （靠 python-dotenv 的 ${} 插值，无需改代码）
#  注意 1：DB_* 必须写在两条 URL 之前，${} 按出现顺序解析。
#  注意 2：DB_PASSWORD 是 **URL 编码后** 的密码（@→%40  #→%23  !→%21  :→%3A  /→%2F），
#          直接写明文会让连接串被截断。
# ══════════════════════════════════════════════════════════════════════════
DB_SCHEME=mysql+pymysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password-url-encoded
DB_QUERY=?charset=utf8mb4
DB_NAME=xsyy
DB_AGENT_NAME=xsyy
# ── 业务库（由上面 DB_* 推导）──
DATABASE_URL=${DB_SCHEME}://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}${DB_QUERY}

# JWT 密钥
JWT_SECRET=your-secret-key-change-in-production

# Kimi API (全部任务: 题目分类、HTML生成、AI助教)
# 获取地址: https://platform.kimi.com/console/api-keys
KIMI_API_KEY=你的_kimi_api_key

# GPTsAPI (仅预览图/封面生成)
# 获取地址: https://gptsapi.net
GPTsAPI_KEY=你的_gptsapi_key
GPTsAPI_BASE=https://api.gptsapi.net/v1
# 图片模型。缺省时代码回退为 gpt-image-2，务必与 GPTsAPI_BASE 对应的账号实际可用模型一致
GPTsAPI_IMAGE_MODEL=gpt-image-2

# ── 备用模型配置（默认模型确定超时/网络异常时切换，动画与封面共用）──
# 当默认模型（KIMI_MODEL 用于动画 / GPTsAPI_IMAGE_MODEL 用于封面）确定超时
# （请求超时/网络异常/网关 524）时，切换到本备用模型重跑相关部分。
# 备用模型预算独立：不与默认模型共享时间预算或重试次数，切换后重新计满。
# 动画生成（文本）与封面生成（图片）共用这一组配置。
# 要求：备用模型需为 OpenAI 兼容接口（/chat/completions 与 /images/generations），
# 且账号内实际可用模型名称必须与 BACKUP_MODEL_NAME 一致。
# 三项均留空 = 不启用备用模型，保持原有降级逻辑。
BACKUP_MODEL_API_KEY=你的_备用模型API密钥
BACKUP_MODEL_BASE_URL=你的_备用模型API地址（如https://api.moonshot.cn/v1）
BACKUP_MODEL_NAME=你的_备用模型名称（如kimi-k2.7-code）

# 封面生成的超时与重试预算（单位：秒）
# 关键约束：PREVIEW_TASK_TIMEOUT_SECONDS 必须大于 PREVIEW_TOTAL_TIMEOUT_SECONDS，
# 否则内层重试还没跑完就会被外层兜底超时掐断，导致封面永久丢失。
# 备用模型预算已独立：切换到备用模型时 deadline 整体重置为
# PREVIEW_BACKUP_TOTAL_TIMEOUT_SECONDS（不与默认模型共享预算），
# 外层兜底会自动把已配置备用模型的独立预算计入，无需手工调大 PREVIEW_TASK_TIMEOUT_SECONDS。
# PREVIEW_TOTAL_TIMEOUT_SECONDS=270              # 内层总预算（请求重试 + 下载，默认模型独享）
# PREVIEW_BACKUP_TOTAL_TIMEOUT_SECONDS=270       # 备用模型独立预算（每切换一级备用重置一次）
# PREVIEW_TASK_TIMEOUT_SECONDS=300               # 外层兜底超时（不含备用独立预算部分）
# PREVIEW_REQUEST_TIMEOUT_SECONDS=180            # 单次请求超时上限，会按剩余预算自动收缩
# PREVIEW_DOWNLOAD_TIMEOUT_SECONDS=60            # 图片下载超时上限
# PREVIEW_MAX_ATTEMPTS=3                         # 请求次数硬上限（切换备用时重新计数）
# PREVIEW_RETRY_BACKOFF_SECONDS=5                # 重试退避间隔
# PREVIEW_MIN_ATTEMPT_SECONDS=10                 # 剩余预算低于此值不再发起新请求

# HTML 续写补齐轮次上限
# HTML_CONTINUE_MAX_ROUNDS=3

# HTML 续写阶段每轮最大输出 token
# HTML_CONTINUE_MAX_TOKENS=16384

# Embedding 模型名称
# EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# 测试模式
# TEST_MODE=0

BETA_CODE=XSYY2026
ADMIN_USERNAMES=admin
DEFAULT_DAILY_MAX_CALLS=6
ANONYMOUS_DAILY_MAX_CALLS=50

# 微信 JS-SDK（微信内置浏览器分享卡片）
# 获取地址: 公众号后台 -> 设置与开发 -> 基本配置 -> AppID / AppSecret
# 注意: 需先在"设置与开发 -> 公众号设置 -> 功能设置"配置 JS 接口安全域名，并把服务器公网 IP 加入 IP 白名单
WX_APPID=你的_公众号AppID
WX_SECRET=你的_公众号AppSecret

# ── 标签智能体平台（agent-platform）代理配置（管理后台「标签智能体审核」页用）──
# 审核页 web/admin/tag_review.html 通过后端 /api/admin/tag-agent/* 代理转发到
# agent-platform 的 /tag-agent/* 接口（阶段三接入识别时同样使用该地址）。
AGENT_PLATFORM_URL=http://127.0.0.1:9000
AGENT_PLATFORM_X_USER_ID=admin
AGENT_PLATFORM_TIMEOUT=180

# ── 标签识别引擎开关（阶段三）──────────────────────────────────────────
# agent ：使用智能体识别（进程内 tag_agent orchestrator，主创建链路 P0 起可用）
# legacy：使用原有提示词识别（knowledge_tag_injector）
# dual  ：agent 优先，失败/低置信/超时降级 legacy（默认，灰度期用；对比达标后切 agent）
TAG_RECOGNITION_ENGINE=dual

# 主创建链路智能体识别预算（秒）：超过则降级 legacy，避免灰度期拖慢建题
# （P0 起 pipeline.execute 的标签识别段使用）
TAG_RECOGNIZE_PIPELINE_BUDGET_SECONDS=120

# ── 标签智能体正式标签库（远程 MySQL knowledge_tag_framework 表）──────────
# 智能体识别（tag_agent）与旧引擎 / 最终对账**共用同一张框架表**，此连接串即
# 智能体的唯一正式标签来源。未配置或连不上时，智能体会回退到内置种子快照
# （标签数远少于正式库），并把库中已存在的标签误判为「新标签」——务必填写。
TAG_AGENT_REMOTE_DB_URL=${DB_SCHEME}://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_AGENT_NAME}${DB_QUERY}

# SVG 纪律 Lint 模式（P1 起，方案 §4.5；见 backend/scene_lint.py）
# strict：硬性违规拒收，带反馈重试 1 次（默认）
# warn  ：硬性违规降级为告警，仅记录放行
# off   ：完全关闭（风险开关，可一键关）
SCENE_LINT_MODE=strict
