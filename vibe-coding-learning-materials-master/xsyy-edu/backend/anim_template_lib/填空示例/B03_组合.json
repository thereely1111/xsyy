      "hi": ["e-3", "e-4"]
    },
    {
      "t": "C 出场：只剩对 D 一场",
      "p": "CD（前面都算过了）",
      "d": "① C 对 A、C 对 B 都数过了，只剩 C 对 D。<br>② 连上最后一条线，全部比赛数完。<br>③ 数线：3 + 2 + 1 = 6 条 = 6 场。",
      "tip": "3 + 2 + 1 = 6。",
      "show": ["ttl", "t-0", "t-0-t", "t-1", "t-1-t", "t-2", "t-2-t", "t-3", "t-3-t",
